SERVICE_NAME={{ service_name }}
ENVIRONMENT=development
DEBUG_MODE=true

USE_REST={{ 'true' if use_rest else 'false' }}
USE_GRPC={{ 'true' if use_grpc else 'false' }}
USE_GRAPHQL={{ 'true' if use_graphql else 'false' }}
USE_CRON_SCHEDULER={{ 'true' if use_cron else 'false' }}
USE_KAFKA_CONSUMER={{ 'true' if use_kafka else 'false' }}
USE_REDIS_SUBSCRIBER={{ 'true' if use_redis_subscriber else 'false' }}
USE_RABBITMQ_WORKER={{ 'true' if use_rabbitmq else 'false' }}
USE_POSTGRES_LISTENER={{ 'true' if use_postgres_listener else 'false' }}
USE_TASK_QUEUE_WORKER={{ 'true' if use_task_queue else 'false' }}

HTTP_PORT=8000
HTTP_ROOT_PATH=/
REST_FRAMEWORK=fastapi

{% if use_sql -%}
SQL_DSN_WRITE=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package }}
{% endif -%}
{% if use_redis -%}
REDIS_DSN_WRITE=redis://localhost:6379/0
{% endif -%}
{% if use_mongo -%}
MONGO_DSN_WRITE=mongodb://localhost:27017/{{ package }}
{% endif %}
CORS_ALLOW_ORIGINS=["*"]
MAX_GOROUTINES=10
