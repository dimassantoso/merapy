.PHONY: run test lint typecheck migration migration-create proto

run:
	python main.py

test:
	pytest -v --tb=short

lint:
	ruff check src tests

typecheck:
	mypy src

migration:
	alembic upgrade head

migration-create:
	@test -n "$(name)" || (echo "usage: make migration-create name=<change>"; exit 1)
	alembic revision --autogenerate -m "$(name)"

migration-down:
	alembic downgrade -1

{% if use_grpc %}proto:
	@find api/proto -name '*.proto' | xargs -I{} python -m grpc_tools.protoc \
		-I api/proto \
		--python_out=src/proto \
		--grpc_python_out=src/proto \
		{}
	@echo "✓ proto stubs generated in src/proto/"
{% endif %}
