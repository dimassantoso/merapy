PYTHON := .venv/bin/python
PIP    := .venv/bin/pip

.PHONY: run test lint typecheck migration migration-create migration-down install{% if use_grpc %} proto{% endif %}

install:
	python3 -m venv .venv
	$(PIP) install -e ".[dev]"

run:
	$(PYTHON) main.py

test:
	.venv/bin/pytest -v --tb=short

lint:
	.venv/bin/ruff check src tests

typecheck:
	.venv/bin/mypy src

migration:
	.venv/bin/alembic upgrade head

migration-create:
	@test -n "$(name)" || (echo "usage: make migration-create name=<change>"; exit 1)
	.venv/bin/alembic revision --autogenerate -m "$(name)"

migration-down:
	.venv/bin/alembic downgrade -1

{% if use_grpc %}proto:
	@find api/proto -name '*.proto' | xargs -I{} $(PYTHON) -m grpc_tools.protoc \
		-I api/proto \
		--python_out=src/proto \
		--grpc_python_out=src/proto \
		{}
	@echo "✓ proto stubs generated in src/proto/"
{% endif %}
