"""Service factory wiring for {{ service_name }}.

Mirrors candi's ``internal/service.go``.
"""

from __future__ import annotations

from merapy.codebase.app.cron_worker.worker import CronWorker
from merapy.codebase.app.graphql_server.server import GraphQLServer
from merapy.codebase.app.grpc_server.server import GRPCServer
from merapy.codebase.app.kafka_worker.worker import KafkaWorker
from merapy.codebase.app.litestar_rest_server.server import LitestarRESTServer
from merapy.codebase.app.postgres_worker.worker import PostgresListenerWorker
from merapy.codebase.app.rabbitmq_worker.worker import RabbitMQWorker
from merapy.codebase.app.redis_worker.worker import RedisWorker
from merapy.codebase.app.rest_server.server import RESTServer
from merapy.codebase.app.task_queue_worker.worker import TaskQueueWorker
from merapy.codebase.factory.app_factory import AppServerFactory
from merapy.codebase.factory.dependency import Dependency, get_dependency
from merapy.codebase.factory.module_factory import ModuleFactory
from merapy.config.config import Config

# @kapynis:moduleImport


class Service:
    """Concrete :class:`ServiceFactory`."""

    name = "{{ service_name }}"

    def __init__(self, cfg: Config) -> None:
        self._cfg = cfg
        self._deps = get_dependency()
        deps = self._deps
        self._modules: list[ModuleFactory] = [
            # @kapynis:moduleInit
        ]
        self._apps: list[AppServerFactory] = self._build_apps()

    def _build_apps(self) -> list[AppServerFactory]:
        env = self._cfg.env
        apps: list[AppServerFactory] = []
        if env.use_rest:
            if env.rest_framework == "litestar":
                apps.append(LitestarRESTServer(self))
            else:
                apps.append(RESTServer(self))
        if env.use_grpc:
            apps.append(GRPCServer(self))
        if env.use_graphql:
            apps.append(GraphQLServer(self))
        if env.use_kafka_consumer:
            apps.append(KafkaWorker(self))
        if env.use_cron_scheduler:
            apps.append(CronWorker(self))
        if env.use_redis_subscriber:
            apps.append(RedisWorker(self))
        if env.use_rabbitmq_worker:
            apps.append(RabbitMQWorker(self))
        if env.use_postgres_listener:
            apps.append(PostgresListenerWorker(self))
        if env.use_task_queue_worker:
            apps.append(TaskQueueWorker(self))
        return apps

    def config(self) -> Config:
        return self._cfg

    def dependency(self) -> Dependency:
        return self._deps

    def modules(self) -> list[ModuleFactory]:
        return self._modules

    def applications(self) -> list[AppServerFactory]:
        return self._apps
