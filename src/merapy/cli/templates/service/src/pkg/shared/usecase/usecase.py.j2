"""Shared usecase UOW. Mirrors candi's ``pkg/shared/usecase/usecase.go``."""

from __future__ import annotations

from typing import Any, Protocol

from merapy.codebase.factory.dependency import Dependency
from merapy.usecase.singleton import (
    UsecaseSingleton,
    set_common_usecase,
)

# @kapynis:usecaseImport


class Usecase(Protocol):
    """Aggregator interface — each module appends one accessor."""

    # @kapynis:usecaseMethod


class _UsecaseImpl:
    # @kapynis:usecaseField

    # @kapynis:usecaseImplementation
    pass


_shared: UsecaseSingleton = UsecaseSingleton()


def set_shared_usecase(deps: Dependency) -> None:
    usecase_inst = _UsecaseImpl()
    set_shared_funcs: list[Any] = []

    # @kapynis:usecaseCommon

    set_common_usecase(usecase_inst)
    for wire in set_shared_funcs:
        wire(usecase_inst)
    _shared.set(usecase_inst)  # type: ignore[arg-type]


def get_shared_usecase() -> Usecase:
    return _shared.get()
