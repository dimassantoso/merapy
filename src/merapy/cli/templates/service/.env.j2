SERVICE_NAME={{ service_name }}
ENVIRONMENT=development
DEBUG_MODE=true
LOAD_CONFIG_TIMEOUT=30s

# Server handlers
USE_REST={{ 'true' if use_rest else 'false' }}
USE_GRPC={{ 'true' if use_grpc else 'false' }}
USE_GRAPHQL={{ 'true' if use_graphql else 'false' }}

# Worker handlers
USE_KAFKA_CONSUMER={{ 'true' if use_kafka else 'false' }}
USE_CRON_SCHEDULER={{ 'true' if use_cron else 'false' }}
USE_REDIS_SUBSCRIBER={{ 'true' if use_redis_subscriber else 'false' }}
USE_TASK_QUEUE_WORKER={{ 'true' if use_task_queue else 'false' }}
USE_POSTGRES_LISTENER={{ 'true' if use_postgres_listener else 'false' }}
USE_RABBITMQ_WORKER={{ 'true' if use_rabbitmq else 'false' }}

HTTP_PORT=8000
HTTP_ROOT_PATH=/
REST_FRAMEWORK=fastapi
{% if use_grpc %}
GRPC_PORT=8002
{% endif %}
{% if use_graphql %}
GRAPHQL_DISABLE_INTROSPECTION=false
{% endif %}
{% if use_task_queue %}
TASK_QUEUE_DASHBOARD_PORT=8080
TASK_QUEUE_DASHBOARD_MAX_CLIENT=5
{% endif %}

BASIC_AUTH_USERNAME=user
BASIC_AUTH_PASS=pass

{% if use_sql %}
SQL_DSN_READ=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package }}
SQL_DSN_WRITE=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package }}
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=5
SQL_ECHO=false
{% endif %}
{% if use_redis %}
REDIS_DSN_READ=redis://localhost:6379/0
REDIS_DSN_WRITE=redis://localhost:6379/0
{% endif %}
{% if use_mongo %}
MONGO_DSN_READ=mongodb://localhost:27017/{{ package }}
MONGO_DSN_WRITE=mongodb://localhost:27017/{{ package }}
MONGO_DB_NAME={{ package }}
{% endif %}
{% if use_kafka %}
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID={{ package }}
KAFKA_CONSUMER_GROUP={{ package }}
{% endif %}
{% if use_rabbitmq %}
RABBITMQ_BROKER=amqp://guest:guest@localhost:5672/
RABBITMQ_CONSUMER_GROUP={{ package }}
RABBITMQ_EXCHANGE_NAME=delayed
{% endif %}

CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true

MAX_WORKERS=10

# Observability — tracing
JAEGER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_BASE_URL=http://localhost:16686
TRACE_BODY_MAX_SIZE=65536

# Build / deployment info (set in CI/CD pipeline)
# APP_VERSION=1.0.0
# BUILD_NUMBER=
# GIT_COMMIT=
# BUILD_DATE=

# Additional env for your service
