class {{ module_pascal }}Module:
    name = "{{ module_snake }}"

    def __init__(self, deps: Dependency) -> None:
{% if use_rest %}        self._rest = {{ module_pascal }}RESTHandler(deps)
{% endif -%}
{% if use_grpc %}        self._grpc = {{ module_pascal }}GRPCHandler()
{% endif -%}
{% if use_graphql %}        self._graphql = {{ module_pascal }}GraphQLHandler()
{% endif -%}
{% if use_kafka %}        self._kafka = {{ module_pascal }}KafkaHandler()
{% endif -%}
{% if use_cron %}        self._cron = {{ module_pascal }}CronHandler()
{% endif -%}
{% if use_redis_subscriber %}        self._redis = {{ module_pascal }}RedisHandler()
