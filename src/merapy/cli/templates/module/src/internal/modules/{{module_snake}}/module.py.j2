{% if use_cron %}            Worker.SCHEDULER: self._cron,
{% endif -%}
{% if use_redis_subscriber %}            Worker.REDIS_SUBSCRIBER: self._redis,
{% endif -%}
{% if use_rabbitmq %}            Worker.RABBITMQ: self._rabbitmq,
{% endif -%}
{% if use_postgres_listener %}            Worker.POSTGRES_LISTENER: self._postgres,
{% endif -%}
{% if use_task_queue %}            Worker.TASK_QUEUE: self._task_queue,
{% endif %}        }
        return _map.get(worker_type)
{% else %}        return None
{% endif %}
