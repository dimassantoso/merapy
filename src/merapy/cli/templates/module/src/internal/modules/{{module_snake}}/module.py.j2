{% if use_rabbitmq %}        self._rabbitmq = {{ module_pascal }}RabbitMQHandler()
{% endif -%}
{% if use_postgres_listener %}        self._postgres = {{ module_pascal }}PostgresHandler()
{% endif -%}
{% if use_task_queue %}        self._task_queue = {{ module_pascal }}TaskQueueHandler()
{% endif %}
    def rest_handler(self) -> RESTHandler | None:
{% if use_rest %}        return self._rest
{% else %}        return None
{% endif %}
    def grpc_handler(self) -> GRPCHandler | None:
{% if use_grpc %}        return self._grpc
{% else %}        return None
{% endif %}
    def graphql_handler(self) -> GraphQLHandler | None:
{% if use_graphql %}        return self._graphql
{% else %}        return None
{% endif %}
    def worker_handler(self, worker_type: Worker) -> WorkerHandler | None:
{% if use_kafka or use_cron or use_redis_subscriber or use_rabbitmq or use_postgres_listener or use_task_queue %}        _map = {
{% if use_kafka %}            Worker.KAFKA: self._kafka,
